# Copy to .env.local for local work; set the same names in Vercel for deploys.

# Case-study visibility (set to "true" and redeploy to publish)
NEXT_PUBLIC_SHOW_BACHAPARTY=
NEXT_PUBLIC_SHOW_HIGHFY=
NEXT_PUBLIC_SHOW_CREEDVINTAGE=
# Dockify is hidden everywhere until this is "true"
NEXT_PUBLIC_SHOW_DOCKIFY=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Tracking is off when empty.
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile (contact form). Test keys are used when empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lab copy of the site ("1" on the bonsify-lab Vercel project only)
NEXT_PUBLIC_LAB=

# Leads go to a Google Sheet through an Apps Script web app (also sent to Formspree unless LEADS_FORMSPREE=0)
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
LEADS_FORMSPREE=
