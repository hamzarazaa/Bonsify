# Copy to .env.local for local work; set the same names in Vercel for deploys.

# Case-study visibility (set to "true" and redeploy to publish)
NEXT_PUBLIC_SHOW_BACHAPARTY=
NEXT_PUBLIC_SHOW_HIGHFY=
NEXT_PUBLIC_SHOW_CREEDVINTAGE=
# Dockify is hidden everywhere until this is "true"
NEXT_PUBLIC_SHOW_DOCKIFY=

# Google Analytics 4 measurement ID (G-XXXXXXXXXX). Tracking is off when empty.
NEXT_PUBLIC_GA_ID=

# Cloudflare Turnstile (contact form). Test keys are used when empty.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Lab copy of the site ("1" on the bonsify-lab Vercel project only)
NEXT_PUBLIC_LAB=

# Leads go to a Google Sheet through an Apps Script web app (also sent to Formspree unless LEADS_FORMSPREE=0)
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=
LEADS_FORMSPREE=

# Automatic reply emails (switched on in /admin under Settings; nothing is sent without SMTP_USER and SMTP_PASS)
# Zoho Mail over SMTP. Use smtp.zoho.eu (EU accounts) or smtp.zoho.in (India) if the mailbox is not on .com.
# With 2FA on, SMTP_PASS must be an app-specific password (Zoho > Security > App passwords).
# Zoho only sends as the logged-in mailbox or its aliases, so MAIL_FROM must be hello@bonsify.io or an alias.
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Bonsify <hello@bonsify.io>
MAIL_REPLY_TO=hello@bonsify.io
